{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "epicfight_logo.png",
  "environment": "*",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "kilt": ">=20.1.14",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "forgeconfigapiport": "*",
    "modmenu": "*",
    "azurelib": "*",
    "azurelibarmor": "*",
    "geckolib": "*",
    "firstperson": "*",
    "iris": "*",
    "player-animator": "*",
    "shouldersurfing": "*",
    "trinkets": "*"
  },
  "entrypoints": {
    "main": [
      "yesman.epicfight.main.EpicFightFabricInitializer"
    ],
    "client": [
      "yesman.epicfight.main.EpicFightFabricClientInitializer"
    ]
  },
  "mixins": [
    "mixins.epicfight.json"
  ],
  "accessWidener": "epicfight.accesswidener"
}
